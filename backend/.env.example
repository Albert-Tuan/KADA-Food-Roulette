# Database
DATABASE_URL="mysql://root:password@localhost:3306/food_roulette"

# JWT
JWT_SECRET="your-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3000
NODE_ENV=development

# CORS
CLIENT_URL=http://localhost:5173

# Optional: Email (for password reset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Supabase Storage (backend only; never expose the service role key to mobile)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-backend-only-service-role-key"
SUPABASE_STORAGE_BUCKET="lockets"
