{
  "name": "food-roulette-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --pass-on-unpruned-suppressions",
    "lint:prune": "eslint src --prune-suppressions",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "localtunnel": "^2.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.6.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
