generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique @db.VarChar(255)
  passwordHash          String            @map("password_hash") @db.VarChar(255)
  passwordVersion       Int               @default(1) @map("password_version")
  displayNamePrivate    String            @map("display_name_private") @db.VarChar(50)
  displayNamePublic     String            @map("display_name_public") @db.VarChar(50)
  publicId              String            @unique @map("public_id") @db.VarChar(20)
  avatarUrl             String?           @map("avatar_url") @db.VarChar(500)
  bio                   String?           @db.VarChar(160)
  phone                 String?           @map("phone") @db.VarChar(20)
  role                  UserRole          @default(USER)
  subscriptionTier      SubTier           @default(FREE) @map("subscription_tier")
  isOnboarded           Boolean           @default(false) @map("is_onboarded")
  lastActiveAt          DateTime?         @map("last_active_at")
  savedRestaurants      Json?             @map("saved_restaurants")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  checkIns              CheckIn[]
  corporateMemberships  CorporateMember?
  friendshipsReceived   Friendship[]      @relation("FriendshipAddressee")
  friendshipsRequested  Friendship[]      @relation("FriendshipRequester")
  groupMemberships      GroupMember[]
  lockets               Locket[]
  menusCaptured         Menu[]            @relation("MenuCapturer")
  notifications         Notification[]
  photosUploaded        RestaurantPhoto[] @relation("PhotoUploader")
  partnerVisits         RestaurantVisit[]
  spinSessionsInitiated SpinSession[]     @relation("SpinInitiator")
  spinSessionsPersonal  SpinSession[]     @relation("SpinPersonal")
  spinWallet            SpinWallet?
  preference            UserPreference?
  votes                 Vote[]
  reviews               Review[]

  @@index([subscriptionTier])
  @@index([deletedAt])
  @@index([lastActiveAt])
  @@map("users")
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@index([status])
  @@map("friendships")
}

model Restaurant {
  id             String                 @id @default(uuid())
  name           String                 @db.VarChar(255)
  address        String?                @db.VarChar(500)
  googlePlaceId  String?                @unique @map("google_place_id")
  lat            Decimal?               @db.Decimal(10, 8)
  lng            Decimal?               @db.Decimal(11, 8)
  source         RestaurantSource       @default(USER_SUBMITTED)
  category       String?                @db.VarChar(100)
  priceLevel     Int?                   @map("price_level")
  rating         Float?                 @default(0)
  phone          String?                @map("phone") @db.VarChar(20)
  status         RestaurantStatus       @default(PENDING)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")
  checkIns       CheckIn[]
  lockets        Locket[]
  menus          Menu[]
  hours          RestaurantHours[]
  partner        RestaurantPartner?
  photos         RestaurantPhoto[]
  spinCandidates SpinSessionCandidate[]
  spinResults    SpinSession[]          @relation("SpinResult")
  reviews        Review[]

  @@index([status])
  @@index([status, category])
  @@index([source])
  @@index([deletedAt])
  @@map("restaurants")
}

model RestaurantHours {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  dayOfWeek    Int        @map("day_of_week")
  openTime     String?    @db.VarChar(5)
  closeTime    String?    @db.VarChar(5)
  isClosed     Boolean    @default(false) @map("is_closed")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("restaurant_hours")
}

model RestaurantPhoto {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  photoUrl     String     @db.VarChar(500)
  displayOrder Int        @default(0) @map("display_order")
  caption      String?    @db.VarChar(255)
  uploadedBy   String?    @map("uploaded_by")
  uploadedAt   DateTime?  @map("uploaded_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  uploader     User?      @relation("PhotoUploader", fields: [uploadedBy], references: [id])

  @@unique([restaurantId, photoUrl])
  @@index([restaurantId, displayOrder])
  @@index([uploadedBy], map: "restaurant_photos_uploaded_by_fkey")
  @@map("restaurant_photos")
}

model Group {
  id              String                 @id @default(uuid())
  name            String?                @db.VarChar(100)
  maxMembers      Int                    @default(20) @map("max_members")
  status          GroupStatus            @default(WAITING)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")
  recommendations CircleRecommendation[]
  members         GroupMember[]
  spinSessions    SpinSession[]

  @@index([status])
  @@index([deletedAt])
  @@map("groups")
}

model GroupMember {
  id        String       @id @default(uuid())
  groupId   String       @map("group_id")
  userId    String       @map("user_id")
  invitedBy String?      @map("invited_by")
  role      GroupRole    @default(MEMBER)
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime     @default(now()) @map("joined_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId])
  @@map("group_members")
}

model SpinSession {
  id             String                 @id @default(uuid())
  groupId        String?                @map("group_id")
  userId         String?                @map("user_id")
  initiatorId    String                 @map("initiator_id")
  categoryFilter String?                @map("category_filter") @db.VarChar(100)
  resultId       String?                @map("result_id")
  status         SpinStatus             @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at")
  completedAt    DateTime?              @map("completed_at")
  recommendation CircleRecommendation?
  candidates     SpinSessionCandidate[]
  group          Group?                 @relation(fields: [groupId], references: [id])
  initiator      User                   @relation("SpinInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  result         Restaurant?            @relation("SpinResult", fields: [resultId], references: [id])
  user           User?                  @relation("SpinPersonal", fields: [userId], references: [id])
  votes          Vote[]

  @@index([groupId])
  @@index([userId])
  @@index([initiatorId])
  @@index([status])
  @@index([createdAt])
  @@index([resultId], map: "spin_sessions_result_id_fkey")
  @@map("spin_sessions")
}

model SpinSessionCandidate {
  id            String      @id @default(uuid())
  spinSessionId String      @map("spin_session_id")
  restaurantId  String      @map("restaurant_id")
  displayOrder  Int         @default(0) @map("display_order")
  isSelected    Boolean     @default(false) @map("is_selected")
  createdAt     DateTime    @default(now()) @map("created_at")
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  spinSession   SpinSession @relation(fields: [spinSessionId], references: [id], onDelete: Cascade)

  @@unique([spinSessionId, restaurantId])
  @@index([spinSessionId])
  @@index([restaurantId])
  @@map("spin_session_candidates")
}

model Vote {
  id            String      @id @default(uuid())
  spinSessionId String      @map("spin_session_id")
  userId        String      @map("user_id")
  value         VoteValue
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  spinSession   SpinSession @relation(fields: [spinSessionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spinSessionId, userId])
  @@index([spinSessionId, value])
  @@index([userId], map: "votes_user_id_fkey")
  @@map("votes")
}

model SpinWallet {
  id        String    @id @default(uuid())
  userId    String    @unique @map("user_id")
  balance   BigInt    @default(0)
  version   Int       @default(0) @map("version")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  logs      SpinLog[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spin_wallets")
}

model SpinLog {
  id           String     @id @default(uuid())
  walletId     String     @map("wallet_id")
  amount       BigInt
  source       SpinSource
  purchaseId   String?    @map("purchase_id")
  adWatchLogId String?    @map("ad_watch_log_id")
  giftId       String?    @map("gift_id")
  referralId   String?    @map("referral_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  purchase     SpinPack?  @relation(fields: [purchaseId], references: [id])
  wallet       SpinWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([purchaseId])
  @@map("spin_logs")
}

model SpinPack {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(100)
  spins     Int
  priceVND  Int       @map("price_vnd")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  purchases SpinLog[]

  @@index([isActive])
  @@map("spin_packs")
}

model Locket {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  restaurantId   String?          @map("restaurant_id")
  imageUrl       String           @map("image_url") @db.VarChar(500)
  thumbnailUrl   String?          @map("thumbnail_url") @db.VarChar(500)
  imageWidth     Int?             @map("image_width")
  imageHeight    Int?             @map("image_height")
  imageBytes     Int?             @map("image_bytes")
  thumbnailBytes Int?             @map("thumbnail_bytes")
  dishName       String?          @map("dish_name") @db.VarChar(80)
  restaurantName String?          @map("restaurant_name") @db.VarChar(120)
  note           String?          @db.VarChar(280)
  rating         Int?
  tags           Json?
  deviceHash     String           @map("device_hash") @db.VarChar(64)
  capturedAt     DateTime         @map("captured_at")
  exifStripped   Boolean          @default(false) @map("exif_stripped")
  lat            Decimal?         @db.Decimal(10, 8)
  lng            Decimal?         @db.Decimal(11, 8)
  visibility     LocketVisibility @default(FRIENDS)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  checkIns       CheckIn[]
  restaurant     Restaurant?      @relation(fields: [restaurantId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([visibility, capturedAt])
  @@index([restaurantId])
  @@index([deletedAt])
  @@map("lockets")
}

model CheckIn {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  restaurantId       String        @map("restaurant_id")
  locketId           String?       @map("locket_id")
  verificationMethod CheckInMethod @default(GPS) @map("verification_method")
  accuracy           Float?        @map("accuracy")
  status             CheckInStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  expiresAt          DateTime      @map("expires_at")
  locket             Locket?       @relation(fields: [locketId], references: [id])
  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([restaurantId, createdAt])
  @@index([locketId], map: "check_ins_locket_id_fkey")
  @@map("check_ins")
}

model Menu {
  id            String     @id @default(uuid())
  restaurantId  String     @map("restaurant_id")
  imageUrl      String     @map("image_url") @db.VarChar(500)
  extractedText String?    @map("extracted_text") @db.Text
  confidence    Float?     @default(0)
  capturedBy    String     @map("captured_by")
  capturedAt    DateTime   @default(now()) @map("captured_at")
  status        MenuStatus @default(PENDING)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  items         MenuItem[]
  capturer      User       @relation("MenuCapturer", fields: [capturedBy], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([capturedBy])
  @@map("menus")
}

model MenuItem {
  id        String  @id @default(uuid())
  menuId    String  @map("menu_id")
  name      String  @db.VarChar(200)
  priceVND  Int?    @map("price_vnd")
  category  String? @db.VarChar(50)
  tags      Json
  sortOrder Int     @default(0) @map("sort_order")
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("menu_items")
}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  cuisineScores       Json     @map("cuisine_scores")
  priceRange          Int      @default(2) @map("price_range")
  dietaryRestrictions Json     @map("dietary_restrictions")
  spiceTolerance      String   @default("medium") @map("spice_tolerance") @db.VarChar(10)
  dislikedIngredients Json?    @map("disliked_ingredients")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model CircleRecommendation {
  id            String       @id @default(uuid())
  groupId       String       @map("group_id")
  spinSessionId String?      @unique @map("spin_session_id")
  menuId        String?      @map("menu_id")
  memberScores  Json         @map("member_scores")
  createdAt     DateTime     @default(now()) @map("created_at")
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  spinSession   SpinSession? @relation(fields: [spinSessionId], references: [id])

  @@index([groupId])
  @@map("circle_recommendations")
}

model RestaurantPartner {
  id                String            @id @default(uuid())
  restaurantId      String            @unique @map("restaurant_id")
  ownerName         String            @map("owner_name") @db.VarChar(100)
  ownerEmail        String            @map("owner_email") @db.VarChar(255)
  ownerPhone        String?           @map("owner_phone") @db.VarChar(20)
  tier              PartnerTier       @default(BASIC)
  fixedFeeVND       Int               @default(0) @map("fixed_fee_vnd")
  ppvRateVND        Int               @default(0) @map("ppv_rate_vnd")
  status            PartnerStatus     @default(ACTIVE)
  referralCode      String?           @unique @map("referral_code") @db.VarChar(20)
  subscriptionStart DateTime?         @map("subscription_start")
  subscriptionEnd   DateTime?         @map("subscription_end")
  analytics         Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  promoCodes        PromoCode[]
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  visits            RestaurantVisit[]

  @@index([tier])
  @@index([status])
  @@index([subscriptionEnd])
  @@map("restaurant_partners")
}

model RestaurantVisit {
  id           String            @id @default(uuid())
  partnerId    String            @map("partner_id")
  userId       String            @map("user_id")
  checkInId    String?           @map("check_in_id")
  lat          Decimal           @map("lat") @db.Decimal(10, 8)
  lng          Decimal           @map("lng") @db.Decimal(11, 8)
  accuracy     Float?            @map("accuracy")
  verifiedAt   DateTime          @default(now()) @map("verified_at")
  billingMonth String            @map("billing_month") @db.VarChar(7)
  billed       Boolean           @default(false)
  billedAt     DateTime?         @map("billed_at")
  partner      RestaurantPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerId, billingMonth])
  @@index([billed])
  @@index([userId], map: "restaurant_visits_user_id_fkey")
  @@map("restaurant_visits")
}

model PromoCode {
  id            String            @id @default(uuid())
  partnerId     String            @map("partner_id")
  code          String            @unique @db.VarChar(20)
  description   String?           @db.VarChar(255)
  discountType  DiscountType      @default(PERCENTAGE)
  discountValue Int               @map("discount_value")
  minOrderVND   Int               @default(0) @map("min_order_vnd")
  maxUses       Int               @default(100) @map("max_uses")
  usedCount     Int               @default(0) @map("used_count")
  validFrom     DateTime          @map("valid_from")
  validUntil    DateTime          @map("valid_until")
  status        PromoStatus       @default(ACTIVE)
  createdAt     DateTime          @default(now()) @map("created_at")
  partner       RestaurantPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@map("promo_codes")
}

model CorporateAccount {
  id                String            @id @default(uuid())
  companyName       String            @map("company_name") @db.VarChar(255)
  companyEmail      String            @map("company_email") @db.VarChar(255)
  companyPhone      String?           @map("company_phone") @db.VarChar(20)
  taxId             String?           @unique @map("tax_id") @db.VarChar(20)
  address           String?           @db.VarChar(500)
  tier              CorporateTier     @default(BASIC)
  maxSeats          Int               @default(10) @map("max_seats")
  status            CorporateStatus   @default(TRIAL)
  subscriptionStart DateTime?         @map("subscription_start")
  subscriptionEnd   DateTime?         @map("subscription_end")
  billingMonthly    Int               @default(0) @map("billing_monthly")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  members           CorporateMember[]

  @@index([status])
  @@map("corporate_accounts")
}

model CorporateMember {
  id        String             @id @default(uuid())
  accountId String             @map("account_id")
  userId    String             @unique @map("user_id")
  role      CorporateUserRole  @default(USER)
  status    CorporateMemStatus @default(ACTIVE)
  joinedAt  DateTime           @default(now()) @map("joined_at")
  expiresAt DateTime?          @map("expires_at")
  account   CorporateAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@map("corporate_members")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Review {
  id               String   @id @default(uuid())
  restaurantId     String   @map("restaurant_id")
  userId           String   @map("user_id")
  
  overallRating    Float    @map("overall_rating")
  tasteRating      Float?   @map("taste_rating")
  serviceRating    Float?   @map("service_rating")
  ambienceRating   Float?   @map("ambience_rating")
  valueRating      Float?   @map("value_rating")
  
  content          String?  @db.Text
  photoUrls        Json?    @map("photo_urls")
  tags             Json?
  isVerifiedVisit  Boolean  @default(false) @map("is_verified_visit")
  
  helpfulCount     Int      @default(0) @map("helpful_count")
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([restaurantId])
  @@index([userId])
  @@map("reviews")
}

enum UserRole {
  USER
  STEWARD
  ADMIN
}

enum SubTier {
  FREE
  PREMIUM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum RestaurantSource {
  GOOGLE_PLACES
  USER_SUBMITTED
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupStatus {
  WAITING
  SPINNING
  VOTING
  DONE
  CANCELLED
}

enum GroupRole {
  MEMBER
  HOST
}

enum MemberStatus {
  PENDING
  ACCEPTED
  VETO
}

enum SpinStatus {
  ACTIVE
  VOTING
  COMPLETED
  CANCELLED
}

enum VoteValue {
  ACCEPT
  VETO
}

enum SpinSource {
  PURCHASE
  AD_WATCH
  REFERRAL
  REWARD
}

enum LocketVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum CheckInStatus {
  ACTIVE
  EXPIRED
  VERIFIED
}

enum CheckInMethod {
  GPS
  QR_CODE
  LOCKET
}

enum MenuStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PartnerTier {
  BASIC
  BRONZE
  SILVER
  GOLD
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TRIAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_VND
}

enum PromoStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

enum CorporateTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum CorporateStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CorporateUserRole {
  USER
  ADMIN
  MANAGER
}

enum CorporateMemStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_INVITE
  LOCKET_NEW
  SYSTEM
}
